  "differences": [
    {
      "name": "1 行 1 列の HTML",
      "description": "TSV は末尾に CRLF を付けない。mdpreview は文字だけをコピーするため HTML を空文字にし、md-table-sticky は table を作る。",
      "input": {
        "rows": 1,
        "cols": 1,
        "cells": [
          {
            "row": 0,
            "col": 0,
            "rowspan": 1,
            "colspan": 1,
            "header": false,
            "text": "値"
          }
        ]
      },
      "sticky": {
        "tsv": "値",
        "html": "<table><tr><td>値</td></tr></table>"
      },
      "mdpreview": {
        "tsv": "値",
        "html": ""
      }
    },
    {
      "name": "空の 1 行 1 列",
      "description": "空の 1 セルの TSV は空文字になる。HTML は mdpreview では空文字、md-table-sticky では空の td を持つ table になる。",
